VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fixture ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 12600 12600 ) ;
TRACKS X 100 DO 63 STEP 200 LAYER metal1 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal1 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal2 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal2 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal3 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal3 ;
GCELLGRID X 0 DO 3 STEP 4200 ;
GCELLGRID Y 0 DO 3 STEP 4200 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 2 ;
- L + NET N + DIRECTION OUTPUT + USE SIGNAL + LAYER metal3 ( -100 -100 ) ( 100 100 ) + FIXED ( 1500 1500 ) N ;
- R + NET N + DIRECTION INPUT + USE SIGNAL + LAYER metal3 ( -100 -100 ) ( 100 100 ) + FIXED ( 9900 1500 ) N ;
END PINS
NETS 1 ;
- N ( PIN L ) ( PIN R ) + USE SIGNAL ;
END NETS
END DESIGN
