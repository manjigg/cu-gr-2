VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fixture ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 12600 12600 ) ;
TRACKS X 100 DO 63 STEP 200 LAYER metal1 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal1 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal2 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal2 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal3 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal3 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal4 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal4 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal5 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal5 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal6 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal6 ;
TRACKS X 100 DO 63 STEP 200 LAYER metal7 ;
TRACKS Y 100 DO 63 STEP 200 LAYER metal7 ;
GCELLGRID X 0 DO 4 STEP 3150 ;
GCELLGRID Y 0 DO 3 STEP 4200 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 2 ;
- A + NET A + DIRECTION INPUT + USE SIGNAL + LAYER metal2 ( -20 -20 ) ( 20 20 ) + FIXED ( 11100 1500 ) N ;
- B + NET B + DIRECTION INPUT + USE SIGNAL + LAYER metal2 ( -20 -20 ) ( 20 20 ) + FIXED ( 11100 1500 ) N ;
END PINS
NETS 2 ;
- A ( PIN A ) + USE SIGNAL ;
- B ( PIN B ) + USE SIGNAL ;
END NETS
END DESIGN
