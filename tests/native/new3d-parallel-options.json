{
  "routing_mode": "fast",
  "seed_order": "local_first",
  "beam_width": 8,
  "hbt_candidate_limit": 8,
  "enable_resource_cache": true,
  "enable_path_cache": true,
  "enable_topology_cache": true,
  "enable_hbt_index": true,
  "enable_hbt_pruning": true,
  "preserve_seed_ties": true,
  "prefer_hbt_nonincrease": true,
  "enable_conflict_optimizer": true,
  "enable_dynamic_pricing": true,
  "local_exact_threshold": 8,
  "enable_group_regeneration": true,
  "group_regeneration_limit": 32,
  "enable_maze_workspace": true,
  "enable_bounded_maze": true,
  "net_seconds": 0.03,
  "enable_parallel_maze": true,
  "conflict_workers": 1,
  "maze_max_retries": 2,
  "maze_batch_factor": 2
}
