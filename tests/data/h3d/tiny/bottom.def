# Synthetic bottom die, in the same bonded x/y frame as top.def.
VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN h3d_tiny_bottom ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 25200 25200 ) ;

ROW R0 unitSite 0 0 N DO 12 BY 1 STEP 2000 0 ;
ROW R1 unitSite 0 2000 N DO 12 BY 1 STEP 2000 0 ;
ROW R2 unitSite 0 4000 N DO 12 BY 1 STEP 2000 0 ;
ROW R3 unitSite 0 6000 N DO 12 BY 1 STEP 2000 0 ;
ROW R4 unitSite 0 8000 N DO 12 BY 1 STEP 2000 0 ;
ROW R5 unitSite 0 10000 N DO 12 BY 1 STEP 2000 0 ;
ROW R6 unitSite 0 12000 N DO 12 BY 1 STEP 2000 0 ;
ROW R7 unitSite 0 14000 N DO 12 BY 1 STEP 2000 0 ;
ROW R8 unitSite 0 16000 N DO 12 BY 1 STEP 2000 0 ;
ROW R9 unitSite 0 18000 N DO 12 BY 1 STEP 2000 0 ;
ROW R10 unitSite 0 20000 N DO 12 BY 1 STEP 2000 0 ;
ROW R11 unitSite 0 22000 N DO 12 BY 1 STEP 2000 0 ;

TRACKS Y 200 DO 63 STEP 400 LAYER M1 M3 ;
TRACKS X 200 DO 63 STEP 400 LAYER M2 ;
GCELLGRID X 0 DO 7 STEP 4200 ;
GCELLGRID Y 0 DO 7 STEP 4200 ;

COMPONENTS 4 ;
- U0 BUF + PLACED ( 2000 10000 ) N ;
- U1 BUF + PLACED ( 18000 10000 ) N ;
- U2 BUF + PLACED ( 10000 2000 ) N ;
- U3 BUF + PLACED ( 10000 18000 ) N ;
END COMPONENTS

PINS 1 ;
- bottom_out + NET bottom_local + DIRECTION OUTPUT + USE SIGNAL
  + LAYER M1 ( -100 -100 ) ( 100 100 )
  + FIXED ( 24000 11000 ) N ;
END PINS

NETS 4 ;
- cross_a ( U0 A ) ( U1 A ) + USE SIGNAL ;
- cross_b ( U0 Y ) ( U2 A ) + USE SIGNAL ;
- cross_c ( U3 A ) + USE SIGNAL ;
- bottom_local ( U1 Y ) ( PIN bottom_out ) + USE SIGNAL ;
END NETS
END DESIGN
